{
  "expo": {
    "name": "Forma",
    "slug": "forma-mobile",
    "scheme": "forma",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.forma.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Forma reads your sleep, heart-rate variability, resting heart rate and steps to score your training readiness.",
        "NSHealthUpdateUsageDescription": "Forma does not write to Health.",
        "UIBackgroundModes": ["fetch", "processing"]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },
    "android": {
      "package": "app.forma.mobile",
      "permissions": [
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_STEPS",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-health",
        { "isClinicalDataEnabled": false, "healthSharePermission": "Forma reads recovery metrics to score training readiness." }
      ],
      "react-native-health-connect"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000/api/v1"
    }
  }
}
