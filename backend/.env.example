# ── Forma backend environment ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Postgres. docker-compose.yml provisions this exact URL.
DATABASE_URL="postgresql://forma:forma@localhost:5432/forma?schema=public"

# Auth
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# CORS — the Vite web companion
WEB_ORIGIN="http://localhost:5178"

# AI orchestration (trainer chat / summaries / plan phrasing). Optional in dev —
# when unset the AI endpoints return deterministic canned responses.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
